        function incrementValue(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                let val = parseInt(el.textContent, 10) || 0;
                if (val < 99) {
                    el.textContent = val + 1;
                }
            }
        }

        // Helper function to decrement plain integer values
        function decrementValue(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                let val = parseInt(el.textContent, 10) || 0;
                if (val > 1) {
                    el.textContent = val - 1;
                }
            }
        }

        // The app stores rest intervals in whole minutes.
        function incrementInterval(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                let currentMinutes = parseInt(el.textContent, 10) || 0;
                if (currentMinutes < 60) {
                    el.textContent = (currentMinutes + 1) + ' min';
                }
            }
        }

        function decrementInterval(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                let currentMinutes = parseInt(el.textContent, 10) || 0;
                if (currentMinutes > 0) {
                    el.textContent = (currentMinutes - 1) + ' min';
                }
            }
        }
    </script>
    <!-- END: InteractiveStepperScript -->
</body>

</html>